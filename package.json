{
  "name": "chauhan-erp",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud-based multi-company ERP system for Retail, Trading, Wholesale, Distribution and Service businesses.",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint --workspace=backend && npm run lint --workspace=frontend"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "UNLICENSED"
}